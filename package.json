{
  "name": "nexo-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Portable engineering harness for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:repository && npm run validate:schemas && npm run validate:canonical",
    "validate:repository": "node --experimental-strip-types tools/validate/repository.ts",
    "validate:schemas": "node --experimental-strip-types tools/validate/schemas.ts",
    "validate:canonical": "node --experimental-strip-types tools/validate/canonical.ts",
    "test": "node --test --experimental-strip-types tests/repository.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
