{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexoharness.dev/schemas/policy.schema.json",
  "title": "Nexo Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Policy" },
    "metadata": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "appliesTo", "decisions"],
      "properties": {
        "summary": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/nonEmptyString" },
        "appliesTo": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" },
        "decisions": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" },
        "relatedRules": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/refList" }
      }
    }
  }
}
