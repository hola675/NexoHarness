{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexoharness.dev/schemas/workflow.schema.json",
  "title": "Nexo Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Workflow" },
    "metadata": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryStep", "steps"],
      "properties": {
        "entryStep": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/id" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action"],
            "properties": {
              "id": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/id" },
              "action": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/nonEmptyString" },
              "next": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/id" },
              "agent": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/entityRef" }
            }
          }
        },
        "failureStates": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" }
      }
    }
  }
}
