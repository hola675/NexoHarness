{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexoharness.dev/schemas/contract.schema.json",
  "title": "Nexo Contract Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Contract" },
    "metadata": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "artifactType", "requiredEnvelopeFields", "payload"],
      "properties": {
        "purpose": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/nonEmptyString" },
        "artifactType": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/nonEmptyString" },
        "requiredEnvelopeFields": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requiredFields": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" },
            "allowedStatuses": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" },
            "nextAgentRef": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/entityRef" }
          }
        }
      }
    }
  }
}
