{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexoharness.dev/schemas/contract.schema.json",
  "title": "Nexo Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Contract" },
    "metadata": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredFields"],
      "properties": {
        "status": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/status" },
        "requiredFields": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" },
        "nextAgent": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/entityRef" }
      }
    }
  }
}
