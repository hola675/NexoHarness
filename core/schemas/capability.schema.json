{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexoharness.dev/schemas/capability.schema.json",
  "title": "Nexo Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Capability" },
    "metadata": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "effect"],
      "properties": {
        "name": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/capabilityName" },
        "purpose": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/nonEmptyString" },
        "effect": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/capabilityEffect" },
        "inputContract": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" },
        "outputContract": { "$ref": "https://nexoharness.dev/schemas/common.schema.json#/$defs/stringList" }
      }
    }
  }
}
