{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexoharness.dev/schemas/common.schema.json",
  "$defs": {
    "apiVersion": {
      "type": "string",
      "const": "nexoharness.dev/v1alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entityRef": {
      "type": "string",
      "pattern": "^(Directive|Policy|Agent|Skill|Rule|Workflow|Contract|Capability|Profile|Enforcement|Evaluation|Observation|ImprovementProposal):[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:@[0-9]+\\.[0-9]+\\.[0-9]+)?$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "entityStatus": {
      "type": "string",
      "enum": ["draft", "experimental", "stable", "deprecated"]
    },
    "completionStatus": {
      "type": "string",
      "enum": ["READY", "PASS", "FAIL", "BLOCKED", "INCOMPLETE", "ESCALATION_REQUIRED"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/version" },
        "status": { "$ref": "#/$defs/entityStatus" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "provenanceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "authorityMode": {
      "type": "string",
      "enum": ["none", "scoped", "allowed"]
    },
    "capabilityName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$",
      "minLength": 3,
      "maxLength": 120
    },
    "capabilityEffect": {
      "type": "string",
      "enum": ["read", "local-write", "external-write", "destructive"]
    },
    "refList": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
